{
  "name": "vue-pure-frame",
  "version": "1.20241119.1",
  "type": "module",
  "scripts": {
    "serve": "cross-env CURRENT_ENV=dev vite",
    "serve:uat": "cross-env CURRENT_ENV=uat vite --mode uat",
    "build": "run-p type-check && cross-env CURRENT_ENV=prod run-p build-only",
    "preview": "vite preview",
    "test": "cross-env CURRENT_ENV=dev playwright test",
    "test:uat": "cross-env CURRENT_ENV=uat playwright test",
    "codegen": "playwright codegen --load-storage=e2e/auth/user.json",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "syncapi": "tsx scripts/syncApi.ts"
  },
  "types": [
    "vite/client"
  ],
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@rushstack/eslint-patch": "^1.10.4",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-legacy": "^5.4.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitejs/plugin-vue-jsx": "^4.1.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/tsconfig": "^0.6.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.31.0",
    "less": "^4.1.3",
    "mockjs-extend": "^1.3.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "sass": "^1.81.0",
    "sharp": "^0.33.5",
    "svgo": "^3.3.2",
    "swagger-typescript-api": "^13.0.22",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.1",
    "vite-plugin-compression2": "^1.3.1",
    "vite-plugin-image-optimizer": "^1.1.8",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-update-version": "^1.0.9",
    "vizion": "^2.2.1",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  }
}
